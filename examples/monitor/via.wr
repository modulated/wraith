// 6522 VIA (Versatile Interface Adapter) driver
// Provides access to parallel I/O, timers, and shift register

// ============================================================================
// 6522 VIA Hardware Definitions
// ============================================================================

// VIA base address - change this to relocate the VIA
const VIA_BASE: u16 = 0xE010;

// VIA registers
const VIA_PORTB: addr = VIA_BASE + 0x00;  // Port B data
const VIA_PORTA: addr = VIA_BASE + 0x01;  // Port A data
const VIA_DDRB: addr = VIA_BASE + 0x02;  // Data Direction Register B
const VIA_DDRA: addr = VIA_BASE + 0x03;  // Data Direction Register A
const VIA_T1CL: addr = VIA_BASE + 0x04;  // Timer 1 Counter Low
const VIA_T1CH: addr = VIA_BASE + 0x05;  // Timer 1 Counter High
const VIA_T1LL: addr = VIA_BASE + 0x06;  // Timer 1 Latch Low
const VIA_T1LH: addr = VIA_BASE + 0x07;  // Timer 1 Latch High
const VIA_T2CL: addr = VIA_BASE + 0x08;  // Timer 2 Counter Low
const VIA_T2CH: addr = VIA_BASE + 0x09;  // Timer 2 Counter High
const VIA_SR: addr = VIA_BASE + 0x0A;  // Shift Register
const VIA_ACR: addr = VIA_BASE + 0x0B;  // Auxiliary Control Register
const VIA_PCR: addr = VIA_BASE + 0x0C;  // Peripheral Control Register
const VIA_IFR: addr = VIA_BASE + 0x0D;  // Interrupt Flag Register
const VIA_IER: addr = VIA_BASE + 0x0E;  // Interrupt Enable Register
const VIA_PORTA_NH: addr = VIA_BASE + 0x0F;  // Port A (no handshake)

// VIA driver functions can be added here as needed
