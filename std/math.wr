// Wraith Math Standard Library
// Mathematical operations optimized for u8 on 65C02
//
// This library provides efficient integer math operations for the 6502/65C02
// processor, focusing on unsigned 8-bit values. Where applicable, 65C02-specific
// instructions (SMB, RMB, BBS) are used for optimal performance.

// ============================================================================
// Comparison Operations
// ============================================================================

/// Return the minimum of two u8 values
/// Optimized assembly: Uses CMP and BCC to avoid boolean intermediate
/// Cycles: ~8 (1 comparison + 1 conditional branch)
#[inline]
pub fn min(a: u8, b: u8) -> u8 {
    asm {
        "LDA {a}",
        "CMP {b}",
        "BCC ISMIN",
        "LDA {b}",
        "ISMIN:",
    }
}

/// Return the maximum of two u8 values
/// Optimized assembly: Uses CMP and BCS to avoid boolean intermediate
/// Cycles: ~8 (1 comparison + 1 conditional branch)
#[inline]
pub fn max(a: u8, b: u8) -> u8 {
    asm {
        "LDA {a}",
        "CMP {b}",
        "BCS ISMAX",
        "LDA {b}",
        "ISMAX:",
    }
}

/// Clamp a value between min and max bounds (inclusive)
/// Optimized assembly: Two comparisons with early exit
/// Cycles: ~12-16 (best case: in range, worst case: clamped twice)
#[inline]
pub fn clamp(value: u8, min_val: u8, max_val: u8) -> u8 {
    asm {
        "LDA {value}",
        "CMP {min_val}",
        "BCS CHECK_MAX",
        "LDA {min_val}",
        "JMP DONE_CLAMP",
        "CHECK_MAX:",
        "CMP {max_val}",
        "BCC DONE_CLAMP",
        "BEQ DONE_CLAMP",
        "LDA {max_val}",
        "DONE_CLAMP:",
    }
}

// ============================================================================
// Bit Manipulation (65C02 SMB/RMB/BBS instructions)
// ============================================================================

/// Set a specific bit (0-7) in a byte using 65C02 SMB instructions
/// Cycles: ~18-20
/// Note: Uses zero page $20 for temporary storage
#[inline]
pub fn set_bit(value: u8, bit: u8) -> u8 {

    asm {
        "LDA {value}",
        "STA $20",

        "LDX {bit}",
        "CPX #$00",
        "BEQ bit0_s",
        "CPX #$01",
        "BEQ bit1_s",
        "CPX #$02",
        "BEQ bit2_s",
        "CPX #$03",
        "BEQ bit3_s",
        "CPX #$04",
        "BEQ bit4_s",
        "CPX #$05",
        "BEQ bit5_s",
        "CPX #$06",
        "BEQ bit6_s",
        "SMB7 $20",
        "JMP done_s",
        "bit0_s:",
        "SMB0 $20",
        "JMP done_s",
        "bit1_s:",
        "SMB1 $20",
        "JMP done_s",
        "bit2_s:",
        "SMB2 $20",
        "JMP done_s",
        "bit3_s:",
        "SMB3 $20",
        "JMP done_s",
        "bit4_s:",
        "SMB4 $20",
        "JMP done_s",
        "bit5_s:",
        "SMB5 $20",
        "JMP done_s",
        "bit6_s:",
        "SMB6 $20",
        "JMP done_s",
        "done_s:",
        "LDA $20",

    }

}

/// Clear a specific bit (0-7) in a byte using 65C02 RMB instructions
/// Cycles: ~18-20
/// Note: Uses zero page $20 for temporary storage
#[inline]
pub fn clear_bit(value: u8, bit: u8) -> u8 {

    asm {
        "LDA {value}",
        "STA $20",

        "LDX {bit}",
        "CPX #$00",
        "BEQ bit0_c",
        "CPX #$01",
        "BEQ bit1_c",
        "CPX #$02",
        "BEQ bit2_c",
        "CPX #$03",
        "BEQ bit3_c",
        "CPX #$04",
        "BEQ bit4_c",
        "CPX #$05",
        "BEQ bit5_c",
        "CPX #$06",
        "BEQ bit6_c",
        "RMB7 $20",
        "JMP done_c",
        "bit0_c:",
        "RMB0 $20",
        "JMP done_c",
        "bit1_c:",
        "RMB1 $20",
        "JMP done_c",
        "bit2_c:",
        "RMB2 $20",
        "JMP done_c",
        "bit3_c:",
        "RMB3 $20",
        "JMP done_c",
        "bit4_c:",
        "RMB4 $20",
        "JMP done_c",
        "bit5_c:",
        "RMB5 $20",
        "JMP done_c",
        "bit6_c:",
        "RMB6 $20",
        "JMP done_c",
        "done_c:",
        "LDA $20",

    }

}

/// Test if a specific bit (0-7) is set using 65C02 BBS instructions
/// Cycles: ~20-22
/// Returns: 1 if bit is set, 0 if clear
/// Note: Uses zero page $20 for temporary storage
#[inline]
pub fn test_bit(value: u8, bit: u8) -> u8 {

    asm {
        "LDA {value}",
        "STA $20",

        "LDX {bit}",
        "CPX #$00",
        "BEQ bit0_t",
        "CPX #$01",
        "BEQ bit1_t",
        "CPX #$02",
        "BEQ bit2_t",
        "CPX #$03",
        "BEQ bit3_t",
        "CPX #$04",
        "BEQ bit4_t",
        "CPX #$05",
        "BEQ bit5_t",
        "CPX #$06",
        "BEQ bit6_t",
        "BBS7 $20,bit_set_t",
        "JMP bit_clear_t",
        "bit0_t:",
        "BBS0 $20,bit_set_t",
        "JMP bit_clear_t",
        "bit1_t:",
        "BBS1 $20,bit_set_t",
        "JMP bit_clear_t",
        "bit2_t:",
        "BBS2 $20,bit_set_t",
        "JMP bit_clear_t",
        "bit3_t:",
        "BBS3 $20,bit_set_t",
        "JMP bit_clear_t",
        "bit4_t:",
        "BBS4 $20,bit_set_t",
        "JMP bit_clear_t",
        "bit5_t:",
        "BBS5 $20,bit_set_t",
        "JMP bit_clear_t",
        "bit6_t:",
        "BBS6 $20,bit_set_t",
        "JMP bit_clear_t",
        "bit_set_t:",
        "LDA #$01",
        "JMP done_t",
        "bit_clear_t:",
        "LDA #$00",
        "done_t:",

    }

}

// ============================================================================
// Saturating Arithmetic
// ============================================================================

/// Add two u8 values with saturation at 255
/// Optimized assembly: Result left in accumulator (no temp variable)
/// Cycles: ~6-8 (saved 2 cycles by eliminating STA)
/// Returns: a + b, or 255 if overflow would occur
#[inline]
pub fn saturating_add(a: u8, b: u8) -> u8 {
    asm {
        "CLC",
        "LDA {a}",
        "ADC {b}",
        "BCC no_overflow_add",
        "LDA #$FF",
        "no_overflow_add:",
    }
}

/// Subtract b from a with saturation at 0
/// Optimized assembly: Result left in accumulator (no temp variable)
/// Cycles: ~6-8 (saved 2 cycles by eliminating STA)
/// Returns: a - b, or 0 if underflow would occur
#[inline]
pub fn saturating_sub(a: u8, b: u8) -> u8 {
    asm {
        "SEC",
        "LDA {a}",
        "SBC {b}",
        "BCS no_underflow_sub",
        "LDA #$00",
        "no_underflow_sub:",
    }
}

// ============================================================================
// Advanced Bit Operations
// ============================================================================

/// Count the number of set bits (population count)
/// Optimized assembly: Uses Y register for counting, TYA at end
/// Cycles: ~58-76 (saved 2 cycles by using TYA instead of STY/LDA)
/// Returns: number of 1 bits in the value
#[inline]
pub fn count_bits(value: u8) -> u8 {
    asm {
        "LDA {value}",
        "LDX #$08",
        "LDY #$00",
        "count_loop:",
        "LSR A",
        "BCC bit_not_set",
        "INY",
        "bit_not_set:",
        "DEX",
        "BNE count_loop",
        "TYA",
    }
}

/// Reverse the bits in a byte
/// Optimized assembly: Uses zero page $20 for temp storage
/// Cycles: ~66-76 (saved cycles by using fixed ZP instead of variable)
/// Example: 0b11010010 -> 0b01001011
/// Note: Uses zero page $20 for temporary storage
#[inline]
pub fn reverse_bits(value: u8) -> u8 {
    asm {
        "LDA #$00",
        "STA $20",
        "LDA {value}",
        "LDX #$08",
        "reverse_loop:",
        "LSR A",
        "ROL $20",
        "DEX",
        "BNE reverse_loop",
        "LDA $20",
    }
}

/// Swap the high and low nibbles of a byte
/// Optimized assembly: Result left in accumulator
/// Cycles: ~10-14 (saved 2 cycles by eliminating STA)
/// Example: 0xAB -> 0xBA
#[inline]
pub fn swap_nibbles(value: u8) -> u8 {
    asm {
        "LDA {value}",
        "ASL A",
        "ADC #$80",
        "ROL A",
        "ADC #$80",
        "ROL A",
        "ADC #$80",
        "ROL A",
        "ADC #$80",
    }
}

// ============================================================================
// Widening / combined arithmetic
// ============================================================================

/// Widening multiply: u8 * u8 -> u16 (full 16-bit product, never truncates).
/// The plain `*` on two u8 values yields a u8 (low byte only); use this when
/// the product can exceed 255.
/// Algorithm: 8-iteration shift-and-add. Uses zero page $20-$24 as scratch.
/// Returns: a * b as a full u16 (A = low, Y = high).
pub fn mul_wide(a: u8, b: u8) -> u16 {
    asm {
        "LDA #$00",
        "STA $20",        // product low
        "STA $21",        // product high
        "LDA {a}",
        "STA $22",        // multiplicand low
        "LDA #$00",
        "STA $23",        // multiplicand high (a is 8-bit)
        "LDA {b}",
        "STA $24",        // multiplier
        "LDX #$08",
        "mulwide_loop:",
        "LSR $24",        // multiplier >>= 1, LSB -> carry
        "BCC mulwide_skip",
        "CLC",
        "LDA $20",
        "ADC $22",
        "STA $20",
        "LDA $21",
        "ADC $23",
        "STA $21",
        "mulwide_skip:",
        "ASL $22",        // multiplicand <<= 1
        "ROL $23",
        "DEX",
        "BNE mulwide_loop",
        "LDA $20",        // low byte -> A
        "LDY $21",        // high byte -> Y
    }
}

/// Combined division and remainder for u8 operands, computed in a single pass.
/// Returns both results packed into a u16: the **quotient** in the low byte
/// (`.low`) and the **remainder** in the high byte (`.high`). This avoids
/// computing `a / b` and `a % b` separately (each a full division).
///
/// Division by zero returns 0xFFFF (quotient 0xFF, remainder 0xFF), matching
/// the div16 convention.
///
/// Example:
/// ```
/// let qr: u16 = divmod(23, 5);
/// let q: u8 = qr.low;   // 4
/// let r: u8 = qr.high;  // 3
/// ```
pub fn divmod(a: u8, b: u8) -> u16 {
    asm {
        "LDA {b}",
        "BNE divmod_ok",
        "LDA #$FF",       // divide by zero -> 0xFFFF
        "TAY",
        "JMP divmod_done",
        "divmod_ok:",
        "LDA {a}",
        "STA $20",        // dividend, becomes quotient
        "LDA #$00",
        "STA $21",        // remainder
        "LDX #$08",
        "divmod_loop:",
        "ASL $20",        // shift dividend left, MSB -> carry
        "ROL $21",        // carry into remainder
        "LDA $21",
        "SEC",
        "SBC {b}",
        "BCC divmod_no",  // remainder < divisor: don't subtract
        "STA $21",        // remainder -= divisor
        "INC $20",        // set quotient bit 0
        "divmod_no:",
        "DEX",
        "BNE divmod_loop",
        "LDA $20",        // quotient -> A (low)
        "LDY $21",        // remainder -> Y (high)
        "divmod_done:",
    }
}

// ============================================================================
// Pseudo-random number generator (16-bit Galois LFSR)
// ============================================================================
//
// State is a 16-bit seed held at zero page $DD-$DE (reserved for the PRNG in the
// compiler memory map). The generator is a maximal-period (65535) Galois LFSR
// with tap mask $B400. It self-seeds to a fixed nonzero value on first use, so
// rand() works without an explicit srand(); call srand() for a chosen sequence.

/// Advance the PRNG and return the next pseudo-random byte (0..=255).
pub fn rand() -> u8 {
    asm {
        "LDA $DD",
        "ORA $DE",
        "BNE rand_step",  // state != 0: use it
        "LDA #$E1",       // first use: self-seed to $ACE1
        "STA $DD",
        "LDA #$AC",
        "STA $DE",
        "rand_step:",
        "LSR $DE",        // 16-bit right shift: high first...
        "ROR $DD",        // ...then low; carry = bit shifted out (the LSB)
        "BCC rand_noxor",
        "LDA $DE",
        "EOR #$B4",       // feedback tap $B400 (low byte is 0)
        "STA $DE",
        "rand_noxor:",
        "LDA $DD",        // return low byte of new state
    }
}

/// Advance the PRNG and return the next pseudo-random 16-bit value.
pub fn rand16() -> u16 {
    asm {
        "LDA $DD",
        "ORA $DE",
        "BNE rand16_step",
        "LDA #$E1",
        "STA $DD",
        "LDA #$AC",
        "STA $DE",
        "rand16_step:",
        "LSR $DE",
        "ROR $DD",
        "BCC rand16_noxor",
        "LDA $DE",
        "EOR #$B4",
        "STA $DE",
        "rand16_noxor:",
        "LDA $DD",        // low -> A
        "LDY $DE",        // high -> Y
    }
}

/// Seed the PRNG. A zero seed is replaced with 1 so the LFSR never gets stuck.
pub fn srand(seed: u16) {
    asm {
        "LDA {seed}",
        "STA $DD",
        "LDA {seed}+1",
        "STA $DE",
        "ORA $DD",        // seed == 0?
        "BNE srand_done",
        "LDA #$01",
        "STA $DD",
        "srand_done:",
    }
}

// ============================================================================
// 16-bit Arithmetic Operations
// ============================================================================

/// Multiply two 16-bit unsigned integers
/// Algorithm: Shift-and-add method (optimized for 6502)
/// Cycles: ~800-1000 (depends on number of set bits in multiplier)
/// Returns: a * b (lower 16 bits if result overflows)
/// Note: Uses zero page $20-$27 for temporary storage
///
/// Parameters a and b are read via {a}/{b} substitution, which resolves to
/// each parameter's actual zero-page frame slot (assigned by the compiler's
/// call-graph frame allocator) rather than a fixed address - the same
/// convention used throughout this file (see min/max above).
///
/// Memory map (working):
/// $20-$21: multiplicand (shifted left each iteration)
/// $22-$23: result accumulator
/// $24-$25: multiplier (shifted right each iteration)
/// $26: loop counter (16 iterations)
pub fn mul16(a: u16, b: u16) -> u16 {
    asm {
        // Initialize result to 0
        "LDA #$00",
        "STA $22",
        "STA $23",

        // Load multiplicand from parameter a into $20-$21
        "LDA {a}",      // a.low
        "STA $20",
        "LDA {a}+1",    // a.high
        "STA $21",

        // Load multiplier from parameter b into $24-$25
        "LDA {b}",      // b.low
        "STA $24",
        "LDA {b}+1",    // b.high
        "STA $25",

        // Initialize loop counter to 16
        "LDX #$10",
        "STX $26",

        "mul16_loop:",
        // Check if LSB of multiplier is set
        "LDA $24",
        "LSR A",
        "BCC mul16_skip_add",

        // Add multiplicand to result
        "CLC",
        "LDA $22",
        "ADC $20",
        "STA $22",
        "LDA $23",
        "ADC $21",
        "STA $23",

        "mul16_skip_add:",
        // Shift multiplier right by 1
        "LSR $25",
        "ROR $24",

        // Shift multiplicand left by 1
        "ASL $20",
        "ROL $21",

        // Decrement counter and loop if not zero
        "DEC $26",
        "BNE mul16_loop",

        // Load result into A (low) and Y (high) per u16 return convention
        "LDA $22",
        "LDY $23",
    }
}

/// Divide two 16-bit unsigned integers
/// Algorithm: Non-restoring division (optimized for 6502)
/// Cycles: ~1200-1400 (16 iterations of shift-subtract)
/// Returns: a / b (quotient), or 0xFFFF if b == 0
/// Note: Uses zero page $20-$27 for temporary storage
///
/// Parameters a and b are read via {a}/{b} substitution, which resolves to
/// each parameter's actual zero-page frame slot (assigned by the compiler's
/// call-graph frame allocator) rather than a fixed address - the same
/// convention used throughout this file (see min/max above).
///
/// Memory map (working):
/// $20-$21: dividend/remainder (modified during division)
/// $22-$23: divisor
/// $24-$25: quotient (result)
/// $26: loop counter (16 iterations)
/// $27: temp for division by zero check
pub fn div16(a: u16, b: u16) -> u16 {
    asm {
        // Divide by zero -> 0xFFFF (documented sentinel).
        "LDA {b}",
        "ORA {b}+1",
        "BNE div16_not_zero",
        "LDA #$FF",
        "TAY",
        "JMP div16_done",

        "div16_not_zero:",
        // Restoring long division. $20/$21 starts as the dividend and is
        // shifted left 16 times, each bit moving into the remainder at
        // $24/$25; the vacated low bit becomes the quotient bit, so $20/$21
        // holds the quotient once the loop finishes.
        //   $20/$21: dividend -> quotient
        //   $22/$23: divisor
        //   $24/$25: remainder (starts at 0)
        //   $26:     loop counter
        "LDA {a}",
        "STA $20",
        "LDA {a}+1",
        "STA $21",
        "LDA {b}",
        "STA $22",
        "LDA {b}+1",
        "STA $23",
        "LDA #$00",
        "STA $24",
        "STA $25",
        "LDX #$10",
        "STX $26",

        "div16_loop:",
        // Shift the dividend left; its MSB falls out into the carry...
        "ASL $20",
        "ROL $21",
        // ...and rotates into the remainder.
        "ROL $24",
        "ROL $25",

        // remainder >= divisor ?
        "LDA $25",
        "CMP $23",
        "BCC div16_skip_sub",
        "BNE div16_do_sub",
        "LDA $24",
        "CMP $22",
        "BCC div16_skip_sub",

        "div16_do_sub:",
        "SEC",
        "LDA $24",
        "SBC $22",
        "STA $24",
        "LDA $25",
        "SBC $23",
        "STA $25",
        // The bit shifted out of the dividend is free: use it for the quotient.
        "INC $20",

        "div16_skip_sub:",
        "DEC $26",
        "BNE div16_loop",

        // Quotient in A (low) / Y (high), per the u16 return convention.
        "LDA $20",
        "LDY $21",

        "div16_done:",
    }
}

