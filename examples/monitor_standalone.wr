// Standalone Monitor - No imports, works with current compiler
// This version inlines all necessary UART code to avoid import issues

// ============================================================================
// Hardware Definitions
// ============================================================================

const UART_BASE: u16 = 0xE000;
const BAUD_9600: u16 = 12;  // Divisor for 1.8432MHz crystal

const UART_RBR: addr = 0xE000;  // Receiver Buffer Register
const UART_THR: addr = 0xE000;  // Transmitter Holding Register
const UART_IER: addr = 0xE001;  // Interrupt Enable Register
const UART_LCR: addr = 0xE003;  // Line Control Register
const UART_MCR: addr = 0xE004;  // Modem Control Register
const UART_LSR: addr = 0xE005;  // Line Status Register
const UART_FCR: addr = 0xE002;  // FIFO Control Register
const UART_DLL: addr = 0xE000;  // Divisor Latch Low
const UART_DLM: addr = 0xE001;  // Divisor Latch High

const UART_LSR_DR: u8   = 0x01;  // Data Ready
const UART_LSR_THRE: u8 = 0x20;  // Transmitter Holding Register Empty
const UART_LCR_DLAB: u8 = 0x80;  // Divisor Latch Access Bit
const UART_LCR_WLS0: u8 = 0x01;  // Word Length Select bit 0
const UART_LCR_WLS1: u8 = 0x02;  // Word Length Select bit 1
const UART_FCR_ENABLE: u8 = 0x01;  // Enable FIFO
const UART_FCR_RFRST: u8  = 0x02;  // Receiver FIFO Reset
const UART_FCR_TFRST: u8  = 0x04;  // Transmitter FIFO Reset

const ASCII_SPACE: u8 = 0x20;
const ASCII_CR: u8 = 0x0D;
const ASCII_LF: u8 = 0x0A;
const ASCII_BS: u8 = 0x08;

// Monitor storage. The buffer lives at $0300, clear of the zero page, the
// hardware stack ($0100-$01FF) and the compiler's software-stack page
// ($0200-$02FF, used for recursion saves and operand spills — u16 math in
// the parser would clobber a command mid-read).
const CMD_BUFFER: u16 = 0x0300;
const CMD_MAX_LEN: u8 = 64;

// Working values shared between the command parser and handlers. (An addr
// const at $00F2 used to serve here — inside the compiler's arg-pool
// scratch region, where any call could destroy it.)
static TEMP_VAL: u8 = 0;
static TEMP_ADDR: u16 = 0;
static TEMP_ADDR2: u16 = 0;

fn set_temp_addr(a: u16) { TEMP_ADDR = a; }
fn get_temp_addr() -> u16 { return TEMP_ADDR; }
fn set_temp_addr2(a: u16) { TEMP_ADDR2 = a; }
fn get_temp_addr2() -> u16 { return TEMP_ADDR2; }

// ============================================================================
// String Constants using str type
// ============================================================================

const WELCOME: str = "\n\rWraith Monitor v1.0\nType 'H' for help\n\n";
const PROMPT: str = "> ";
const ERROR: str = "?ERR\n";
const OK: str = "OK\n";
const HELP_HEADER: str = "Commands:\n";
const HELP_READ: str = "R AAAA - Read\n";
const HELP_WRITE: str = "W AAAA DD - Write\n";
const HELP_GO: str = "G AAAA - Go\n";
const HELP_DUMP: str = "D AAAA BBBB - Dump\n";
const JUMP_TO: str = "Jump to ";
const RETURNED: str = "\nReturned\n";


// ============================================================================
// Memory Operations
// ============================================================================

fn mem_read(address: u16) -> u8 {
    asm {
        "LDY #$00",
        "LDA ({address}),Y"
    }
}

fn mem_write(address: u16, value: u8) {
    asm {
        "LDY #$00",
        "LDA {value}",
        "STA ({address}),Y"
    }
}

fn mem_jump(address: u16) {
    asm {
        "JMP ({address})"
    }
}

// ============================================================================
// UART Driver (16550, polled)
// ============================================================================

fn uart_init() {
    UART_IER = 0x00;         // polled I/O, no interrupts
    UART_LCR = UART_LCR_DLAB;
    UART_DLL = 12;           // BAUD_9600 low
    UART_DLM = 0;            // BAUD_9600 high
    UART_LCR = UART_LCR_WLS0 | UART_LCR_WLS1;  // 8 data bits, no parity
    UART_FCR = UART_FCR_ENABLE | UART_FCR_RFRST | UART_FCR_TFRST;
}

fn uart_putc(ch: u8) {
    loop {
        if (UART_LSR & UART_LSR_THRE) != 0 { break; }
    }
    UART_THR = ch;
}

fn uart_getc() -> u8 {
    loop {
        if (UART_LSR & UART_LSR_DR) != 0 { break; }
    }
    return UART_RBR;
}

fn uart_puts(s: str) {
    for c in s {
        uart_putc(c);
    }
}

fn uart_space() { uart_putc(ASCII_SPACE); }

fn uart_newline() {
    uart_putc(ASCII_CR);
    uart_putc(ASCII_LF);
}

fn nibble_to_hex(n: u8) -> u8 {
    if n < 10 { return 0x30 + n; }   // '0'
    return 0x41 + (n - 10);          // 'A'
}

fn uart_puthex_byte(v: u8) {
    uart_putc(nibble_to_hex(v >> 4));
    uart_putc(nibble_to_hex(v & 0x0F));
}

fn uart_puthex_word(w: u16) {
    uart_puthex_byte(w.high);
    uart_puthex_byte(w.low);
}

fn print_ok() { uart_puts(OK); }

fn print_error() { uart_puts(ERROR); }

fn print_help() {
    uart_puts(HELP_HEADER);
    uart_puts(HELP_READ);
    uart_puts(HELP_WRITE);
    uart_puts(HELP_GO);
    uart_puts(HELP_DUMP);
}

fn print_welcome() { uart_puts(WELCOME); }

fn print_prompt() { uart_puts(PROMPT); }

fn uart_getline(max: u8) -> u8 {
    let len: u8 = 0;
    loop {
        let ch: u8 = uart_getc();
        if ch == ASCII_CR {
            uart_newline();
            return len;
        }
        if ch == ASCII_BS {
            if len > 0 {
                len = len - 1;
                uart_putc(ASCII_BS);
            }
        } else if len < max {
            mem_write(CMD_BUFFER + (len as u16), ch);
            len = len + 1;
            uart_putc(ch);  // echo
        }
    }
}

// ============================================================================
// Command Parser
// ============================================================================

fn skip_spaces(pos: u8) -> u8 {
    let p: u8 = pos;
    let done: u8 = 0;
    loop {
        if done != 0 { break; }
        let ch: u8 = mem_read(CMD_BUFFER + (p as u16));
        if ch == ASCII_SPACE {
            p = p + 1;
        } else {
            done = 1;
        }
    }
    return p;
}

fn hex_to_nibble(ch: u8) -> u8 {
    if ch >= 0x30 && ch <= 0x39 {  // '0'..'9'
        return ch - 0x30;
    }
    if ch >= 0x41 && ch <= 0x46 {  // 'A'..'F'
        return ch - 0x41 + 10;
    }
    if ch >= 0x61 && ch <= 0x66 {  // 'a'..'f'
        return ch - 0x61 + 10;
    }
    return 0xFF;  // not a hex digit
}

fn parse_hex_word(pos: u8) -> u8 {
    let p: u8 = pos;
    let result: u16 = 0 as u16;
    let i: u8 = 0;
    loop {
        if i >= 4 { break; }
        let ch: u8 = mem_read(CMD_BUFFER + (p as u16));
        let nibble: u8 = hex_to_nibble(ch);
        if nibble == 0xFF {
            return 0xFF;
        }
        result = (result << 4) | (nibble as u16);
        p = p + 1;
        i = i + 1;
    }

    set_temp_addr(result);
    return p;
}

fn parse_hex_byte(pos: u8) -> u8 {
    let p: u8 = pos;
    let ch1: u8 = mem_read(CMD_BUFFER + (p as u16));
    let ch2: u8 = mem_read(CMD_BUFFER + ((p + 1) as u16));

    let result: u8 = hex_to_byte(ch1, ch2);
    TEMP_VAL = result;
    return p + 2;
}

fn hex_to_byte(hi: u8, lo: u8) -> u8 {
    let h: u8 = hex_to_nibble(hi);
    let l: u8 = hex_to_nibble(lo);
    if h == 0xFF || l == 0xFF {
        return 0;
    }
    return (h << 4) | l;
}

// ============================================================================
// Command Handlers
// ============================================================================

fn cmd_read() {
    let address: u16 = get_temp_addr();
    let value: u8 = mem_read(address);
    uart_puthex_word(address);
    uart_putc(0x3A);  // :
    uart_space();
    uart_puthex_byte(value);
    uart_newline();
}

fn cmd_write() {
    mem_write(get_temp_addr(), TEMP_VAL);
    print_ok();
}

fn cmd_go() {
    let address: u16 = get_temp_addr();
    uart_puts(JUMP_TO);
    uart_puthex_word(address);
    uart_newline();
    mem_jump(address);
    uart_puts(RETURNED);
}

fn cmd_dump() {
    let address: u16 = get_temp_addr();
    let end: u16 = get_temp_addr2();
    let count: u8 = 0;
    loop {
        if address > end { break; }

        if count == 0 {
            uart_puthex_word(address);
            uart_putc(0x3A);  // :
            uart_space();
        }

        let value: u8 = mem_read(address);
        uart_puthex_byte(value);
        uart_space();

        address = address + (1 as u16);
        count = count + 1;

        if count >= 16 {
            uart_newline();
            count = 0;
        }
    }

    if count != 0 {
        uart_newline();
    }
}

// ============================================================================
// Command Dispatcher
// ============================================================================

fn process_command(len: u8) {
    if len == 0 { return; }

    let cmd: u8 = mem_read(CMD_BUFFER);

    if cmd >= 0x61 && cmd <= 0x7A {
        cmd = cmd - 0x20;
    }

    let pos: u8 = 1;
    pos = skip_spaces(pos);

    if cmd == 0x48 {
        print_help();
        return;
    } else if cmd == 0x52 {
        pos = parse_hex_word(pos);
        if pos != 0xFF {
            cmd_read();
            return;
        }
    } else if cmd == 0x57 {
        pos = parse_hex_word(pos);
        if pos != 0xFF {
            pos = skip_spaces(pos);
            pos = parse_hex_byte(pos);
            if pos != 0xFF {
                cmd_write();
                return;
            }
        }
    } else if cmd == 0x47 {
        pos = parse_hex_word(pos);
        if pos != 0xFF {
            cmd_go();
            return;
        }
    } else if cmd == 0x44 {
        pos = parse_hex_word(pos);
        if pos != 0xFF {
            let start: u16 = get_temp_addr();
            pos = skip_spaces(pos);
            pos = parse_hex_word(pos);
            if pos != 0xFF {
                set_temp_addr2(get_temp_addr());
                set_temp_addr(start);
                cmd_dump();
                return;
            }
        }
    }

    print_error();
}

// ============================================================================
// Main Monitor Loop
// ============================================================================

#[reset]
fn main() {
    // CPU initialization
    asm {
        "LDX #$FF",
        "TXS",           // Set stack pointer
        "CLD",           // Clear decimal mode
        "SEI"            // Disable interrupts
    }

    uart_init();
    print_welcome();

    loop {
        print_prompt();
        let len: u8 = uart_getline(CMD_MAX_LEN);
        process_command(len);
    }
}
