// Wraith Standard Library
// String-value helpers over the length-prefixed `str` type.
//
// `str == str` / `str != str` already test equality; this module adds the
// ordering comparison. (Raw-buffer copies live in `std/mem.wr` as `str_copy`.)

/// Lexicographic comparison of two strings, like C's `strcmp` clamped to
/// -1/0/1: returns -1 if `a` sorts before `b`, 1 if after, 0 if equal.
///
/// Characters are compared by ASCII byte value; if one string is a prefix of
/// the other, the shorter one sorts first. A `str` is at most 255 bytes, so the
/// length and index both fit in a `u8`.
pub fn strcmp(a: str, b: str) -> i8 {
    let la: u8 = a.len as u8;
    let lb: u8 = b.len as u8;

    // Compare over the shorter length.
    let n: u8 = la;
    if lb < n {
        n = lb;
    }

    let i: u8 = 0;
    while i < n {
        let ca: u8 = a[i] as u8;
        let cb: u8 = b[i] as u8;
        if ca < cb {
            return -1;
        }
        if ca > cb {
            return 1;
        }
        i = i + 1;
    }

    // Common prefix is equal: the shorter string sorts first.
    if la < lb {
        return -1;
    }
    if la > lb {
        return 1;
    }
    return 0;
}

// ============================================================================
// BCD <-> string
//
// The `*_to_string` functions write a length-prefixed `[u8 len][ASCII digits]`
// block into a caller buffer (a `[u8; N]` passed by `&`), so the buffer is a
// valid `str` and the return value is the digit count. Leading zeros are
// suppressed, but a zero value still yields "0". Same shape as `str_copy`.
// ============================================================================

/// Format a BCD byte (0-99) as ASCII decimal into `dest`. Returns the digit
/// count (1 or 2). `dest` needs room for 1 + 2 = 3 bytes.
pub fn bcd_to_string(value: b8, dest: &u8) -> u16 {
    let packed: u8 = value as u8;
    let tens: u8 = (packed >> 4) & 0x0F;
    let ones: u8 = packed & 0x0F;

    if tens != 0 {
        dest[0] = 2; // length prefix
        dest[1] = tens + 48; // '0' is 48
        dest[2] = ones + 48;
        return 2 as u16;
    }
    dest[0] = 1;
    dest[1] = ones + 48;
    return 1 as u16;
}

/// Format a 16-bit BCD value (0-9999) as ASCII decimal into `dest`. Returns the
/// digit count (1-4). `dest` needs room for 1 + 4 = 5 bytes.
pub fn bcd16_to_string(value: b16, dest: &u8) -> u16 {
    let packed: u16 = value as u16;
    let d3: u8 = (packed >> 12) as u8 & 0x0F; // thousands
    let d2: u8 = (packed >> 8) as u8 & 0x0F; // hundreds
    let d1: u8 = (packed >> 4) as u8 & 0x0F; // tens
    let d0: u8 = packed as u8 & 0x0F; // ones

    // Write the most-significant non-zero digit first, then every digit after
    // it (so interior zeros like the 0 in "1024" are kept). `n` counts digits
    // written; the data starts at dest[1], past the length prefix.
    let n: u8 = 0;
    if d3 != 0 {
        dest[1 + n] = d3 + 48;
        n = n + 1;
    }
    if d2 != 0 || n != 0 {
        dest[1 + n] = d2 + 48;
        n = n + 1;
    }
    if d1 != 0 || n != 0 {
        dest[1 + n] = d1 + 48;
        n = n + 1;
    }
    // Ones digit is always written, so a zero value yields "0".
    dest[1 + n] = d0 + 48;
    n = n + 1;

    dest[0] = n;
    return n as u16;
}

/// Parse a string of ASCII decimal digits (up to 4) into a 16-bit BCD value.
///
/// Each digit becomes one BCD nibble directly, so the accumulator is already in
/// BCD layout — the final `as b16` is a bit-pattern retype, not a decimal
/// conversion. Non-digit characters are not validated; keep the input to
/// '0'..='9' (see `std/char.wr`'s `is_digit`). Digits past the fourth overflow
/// out the top of the 16-bit value.
pub fn string_to_bcd(s: str) -> b16 {
    let acc: u16 = 0 as u16;
    let len: u8 = s.len as u8;
    let i: u8 = 0;
    while i < len {
        let d: u8 = s[i] as u8 - 48; // '0' is 48
        acc = (acc << 4) | (d as u16);
        i = i + 1;
    }
    return acc as b16;
}

// ============================================================================
// Plain binary <-> string
//
// The base-10 and base-16 counterparts of the BCD helpers, for ordinary `u8`
// and `u16` values. Same buffer convention: a `*_to_*` writes a length-prefixed
// `[u8 len][ASCII]` block (a valid `str`) into a caller buffer and returns the
// character count. Hex is *fixed width* (leading zeros kept), the form an
// address or register dump wants; decimal suppresses leading zeros.
// ============================================================================

/// The uppercase ASCII hex digit for a nibble 0..=15.
fn hex_nibble(n: u8) -> u8 {
    if n < 10 {
        return n + 48; // '0'
    }
    return n + 55; // 'A' is 65 = 10 + 55
}

/// Format a `u8` as exactly two uppercase hex digits into `dest`. Returns 2.
/// `dest` needs 1 + 2 = 3 bytes. `0x2A` becomes "2A", `0x05` becomes "05".
pub fn u8_to_hex(value: u8, dest: &u8) -> u16 {
    dest[0] = 2; // length prefix
    dest[1] = hex_nibble((value >> 4) & 0x0F);
    dest[2] = hex_nibble(value & 0x0F);
    return 2 as u16;
}

/// Format a `u16` as exactly four uppercase hex digits into `dest`, most
/// significant first. Returns 4. `dest` needs 1 + 4 = 5 bytes. `0x002A`
/// becomes "002A" — fixed width, the convention a hex dump wants.
pub fn u16_to_hex(value: u16, dest: &u8) -> u16 {
    dest[0] = 4; // length prefix
    dest[1] = hex_nibble((value >> 12) as u8 & 0x0F);
    dest[2] = hex_nibble((value >> 8) as u8 & 0x0F);
    dest[3] = hex_nibble((value >> 4) as u8 & 0x0F);
    dest[4] = hex_nibble(value as u8 & 0x0F);
    return 4 as u16;
}

/// Format a `u16` as ASCII decimal into `dest`, most significant digit first,
/// leading zeros suppressed — but a zero value still yields "0". Returns the
/// digit count (1-5). `dest` needs 1 + 5 = 6 bytes. Division by the constant
/// powers of ten is the compiler's problem, not the caller's.
pub fn u16_to_string(value: u16, dest: &u8) -> u16 {
    let n: u16 = value;
    let started: u8 = 0;
    let count: u8 = 0;
    let scale: u16 = 10000;
    while scale != 0 {
        let d: u8 = (n / scale).low;
        n = n % scale;
        if d != 0 {
            started = 1;
        }
        if started != 0 {
            dest[1 + count] = d + 48; // '0'
            count = count + 1;
        }
        scale = scale / 10;
    }
    if started == 0 {
        dest[1] = 48; // "0"
        count = 1;
    }
    dest[0] = count;
    return count as u16;
}

/// Parse a string of ASCII hex digits into a `u16`. Parsing stops at the first
/// non-hex character; an empty or all-non-hex string yields 0, and digits past
/// the fourth overflow out the top. The base-16 companion of `string_to_bcd`.
pub fn hex_to_u16(s: str) -> u16 {
    let acc: u16 = 0 as u16;
    let len: u8 = s.len as u8;
    let i: u8 = 0;
    while i < len {
        let c: u8 = s[i] as u8;
        let d: u8 = 0xFF;
        if c >= 48 && c <= 57 {
            d = c - 48; // '0'-'9'
        } else if c >= 65 && c <= 70 {
            d = c - 65 + 10; // 'A'-'F'
        } else if c >= 97 && c <= 102 {
            d = c - 97 + 10; // 'a'-'f'
        }
        if d == 0xFF {
            break;
        }
        acc = (acc << 4) | (d as u16);
        i = i + 1;
    }
    return acc;
}
