// Wraith Standard Library
// ASCII character classification and conversion.
//
// A string is an array of `char` (see the language spec), so these pair
// directly with string indexing and `for c in s` iteration. Everything here is
// pure and `#[inline]`, so a call compiles to the comparison itself with no
// function-call overhead.

// ============================================================================
// Classification
// ============================================================================

/// True if `c` is an ASCII decimal digit, '0'..='9'.
#[inline]
pub fn is_digit(c: char) -> bool {
    return c >= '0' && c <= '9';
}

/// True if `c` is an ASCII uppercase letter, 'A'..='Z'.
#[inline]
pub fn is_upper(c: char) -> bool {
    return c >= 'A' && c <= 'Z';
}

/// True if `c` is an ASCII lowercase letter, 'a'..='z'.
#[inline]
pub fn is_lower(c: char) -> bool {
    return c >= 'a' && c <= 'z';
}

/// True if `c` is an ASCII letter (upper- or lowercase).
#[inline]
pub fn is_alpha(c: char) -> bool {
    return is_upper(c) || is_lower(c);
}

/// True if `c` is an ASCII letter or decimal digit.
#[inline]
pub fn is_alnum(c: char) -> bool {
    return is_alpha(c) || is_digit(c);
}

/// True if `c` is ASCII whitespace: space, tab, newline, or carriage return.
#[inline]
pub fn is_whitespace(c: char) -> bool {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r';
}

/// True if `c` is an ASCII hex digit: '0'..='9', 'a'..='f', or 'A'..='F'.
#[inline]
pub fn is_hex_digit(c: char) -> bool {
    return is_digit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
}

// ============================================================================
// Conversion
// ============================================================================

/// Uppercase an ASCII letter. Non-letters are returned unchanged.
///
/// 'a'..='z' differ from 'A'..='Z' by exactly 0x20, so lowercasing is a
/// subtract done on the raw byte and cast back to `char`.
#[inline]
pub fn to_upper(c: char) -> char {
    if is_lower(c) {
        return (c as u8 - 32) as char;
    }
    return c;
}

/// Lowercase an ASCII letter. Non-letters are returned unchanged.
#[inline]
pub fn to_lower(c: char) -> char {
    if is_upper(c) {
        return (c as u8 + 32) as char;
    }
    return c;
}

/// Numeric value of a decimal digit '0'..='9' (0..=9). Returns 0xFF for any
/// non-digit, so a caller can both parse and validate in one step.
#[inline]
pub fn digit_value(c: char) -> u8 {
    if is_digit(c) {
        return c as u8 - 48; // '0' is 0x30
    }
    return 0xFF;
}

/// Numeric value of a hex digit '0'..='9','a'..='f','A'..='F' (0..=15). Returns
/// 0xFF for any non-hex character, so a caller can parse and validate at once —
/// the base-16 sibling of `digit_value`.
#[inline]
pub fn hex_value(c: char) -> u8 {
    if is_digit(c) {
        return c as u8 - 48; // '0' is 0x30
    }
    if c >= 'a' && c <= 'f' {
        return c as u8 - 97 + 10; // 'a' is 0x61
    }
    if c >= 'A' && c <= 'F' {
        return c as u8 - 65 + 10; // 'A' is 0x41
    }
    return 0xFF;
}

/// The uppercase ASCII hex digit for a nibble: 0..=9 -> '0'..='9', 10..=15 ->
/// 'A'..='F'. Only the low four bits are read, so any byte is safe to pass.
#[inline]
pub fn to_hex_digit(n: u8) -> char {
    let d: u8 = n & 0x0F;
    if d < 10 {
        return (d + 48) as char; // '0'
    }
    return (d + 55) as char; // 'A' is 65 = 10 + 55
}
