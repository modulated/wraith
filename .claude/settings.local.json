{
  "permissions": {
    "allow": [
      "Bash(cargo test:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo build:*)",
      "Bash(git add:*)",
      "Bash(cargo run:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(git grep:*)",
      "Bash(git add:*)",
      "Bash(git stash:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(xxd:*)",
      "Bash(cargo fmt:*)",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__add_repo"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cargo fmt --quiet 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
